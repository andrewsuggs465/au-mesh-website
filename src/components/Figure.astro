---
/**
 * A photo with a caption, for use inside `.mdx` posts.
 *
 * `alt` describes the picture for anyone who cannot see it; `caption` is the
 * label printed underneath for everyone. They are different jobs, so write both
 * rather than repeating one in the other.
 */
import { Image } from 'astro:assets';

interface Props {
	src: ImageMetadata;
	alt: string;
	caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="figure not-content">
	<Image
		src={src}
		alt={alt}
		width={1200}
		widths={[480, 800, 1200]}
		sizes="(min-width: 60rem) 46rem, 100vw"
		loading="lazy"
	/>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.figure {
		margin: 2rem auto;
		max-width: 46rem;
	}
	/* Capping the height with `width: auto` keeps the aspect ratio and shrinks
	   the whole image. Capping it with a full-width box would letterbox instead,
	   and a portrait photo would come out with bars down both sides. */
	.figure img {
		display: block;
		margin-inline: auto;
		max-width: 100%;
		max-height: 34rem;
		width: auto;
		height: auto;
		border-radius: 8px;
		border: 1px solid var(--border-color);
	}
	figcaption {
		margin-top: 0.55rem;
		font-size: 0.82rem;
		line-height: 1.5;
		color: var(--sl-color-gray-3);
	}
</style>
