---
import { nextEntry, type CalendarEntry } from '../lib/calendar';

const event: CalendarEntry | undefined = nextEntry();
const date = event?.date ?? null;
const shortDate = date?.toLocaleDateString('en-US', {
	weekday: 'short',
	month: 'short',
	day: 'numeric',
	timeZone: 'UTC',
});
---

{
	event && (
		<a class="next-event not-content" href="/calendar/">
			<span class="label">Next up</span>
			<span class="date">{shortDate}</span>
			<span class="name">
				{event.title}
				{event.tentative && <span class="tent">tentative</span>}
			</span>
			<span class="more">Full calendar →</span>
		</a>
	)
}

<style>
	.next-event {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem 1rem;
		margin-top: 0.5rem;
		padding: 0.85rem 1.25rem;
		border: 1px solid var(--border-color);
		border-radius: 8px;
		background-color: rgba(104, 234, 149, 0.04);
		text-decoration: none;
		transition: border-color 0.2s ease, background-color 0.2s ease;
	}
	.next-event:hover {
		border-color: rgba(104, 234, 149, 0.5);
		background-color: rgba(104, 234, 149, 0.07);
		text-decoration: none;
	}

	.label {
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--primary-color);
	}
	.date {
		font-family: var(--sl-font-mono), monospace;
		font-size: 0.9rem;
		color: var(--primary-color);
	}
	.name {
		font-weight: 600;
		color: var(--fg-color);
	}
	.tent {
		margin-left: 0.5rem;
		font-size: 0.7rem;
		font-weight: 500;
		color: var(--sl-color-gray-3);
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 10px;
		padding: 0.05rem 0.5rem;
		vertical-align: middle;
	}
	.more {
		margin-left: auto;
		font-size: 0.875rem;
		color: var(--sl-color-gray-3);
	}
	.next-event:hover .more {
		color: var(--primary-color);
	}
</style>
