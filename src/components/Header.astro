---
// Custom Starlight header: default title/search/social plus top-level
// club navigation so the site works as a hub, not just docs.
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';

// Top-level sections. Everything outside /documentation/ is a sidebar-less
// splash page, so this nav is the only way between sections — it stays
// visible at every width (scrolls sideways when it doesn't fit).
const links = [
	{ label: 'Home', href: '/' },
	{ label: 'News', href: '/news/' },
	{ label: 'Events', href: '/events/' },
	{ label: 'Workshops', href: '/workshops/' },
	{ label: 'Projects', href: '/projects/' },
	{ label: 'Tools', href: '/tools/' },
	{ label: 'Docs', href: '/documentation/' },
];

const { pathname } = Astro.url;
const isCurrent = (href: string) =>
	href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<div class="header sl-flex">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>
	<nav class="site-nav sl-flex" aria-label="Site">
		{
			links.map((link) => (
				<a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
					{link.label}
				</a>
			))
		}
	</nav>
	<div class="sl-flex print:hidden search-wrapper">
		<Search />
	</div>
	<div class="sl-hidden md:sl-flex print:hidden right-group">
		<div class="sl-flex social-icons">
			<SocialIcons />
		</div>
	</div>
</div>

<style>
	.header {
		gap: var(--sl-nav-gap);
		justify-content: space-between;
		align-items: center;
		height: 100%;
		/* the bar is full-bleed, but its contents line up with the page frame
		   so the logo sits above the content rather than out at the window edge */
		max-width: var(--au-frame-width);
		margin-inline: auto;
		width: 100%;
	}

	.title-wrapper {
		overflow: clip;
		padding: 0.25rem;
		margin: -0.25rem;
		min-width: 0;
	}

	.site-nav {
		gap: 1.25rem;
		align-items: center;
		min-width: 0;
		overflow-x: auto;
		scrollbar-width: none;
		-ms-overflow-style: none;
	}
	.site-nav::-webkit-scrollbar {
		display: none;
	}
	.site-nav a {
		white-space: nowrap;
	}

	/* below the desktop breakpoint the nav is the only navigation there is,
	   so tighten it rather than hiding it */
	@media (max-width: 72rem) {
		.site-nav {
			gap: 0.85rem;
		}
	}
	.site-nav a {
		color: #fff;
		font-weight: 600;
		font-size: var(--sl-text-sm);
		text-decoration: none;
		padding: 0.25rem 0.15rem;
		border-bottom: 2px solid transparent;
	}
	.site-nav a:hover {
		border-bottom-color: rgba(104, 234, 149, 0.6);
	}
	.site-nav a[aria-current='page'] {
		border-bottom-color: var(--primary-color);
		color: var(--primary-color);
	}

	.search-wrapper {
		flex: 1;
		justify-content: flex-end;
		max-width: 20rem;
		margin-inline-start: auto;
	}

	.right-group,
	.social-icons {
		gap: 1rem;
		align-items: center;
	}
</style>
