---
// Custom Starlight header: default title/search/social plus top-level
// club navigation so the site works as a hub, not just docs.
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';

// Top-level sections. Everything outside /documentation/ is a sidebar-less
// splash page, so this nav is the only way between sections, so it stays
// visible at every width (scrolls sideways when it doesn't fit).
const links = [
	{ label: 'Home', href: '/' },
	{ label: 'News', href: '/news/' },
	{ label: 'Calendar', href: '/calendar/' },
	{ label: 'Project Hub', href: '/projects/' },
	{ label: 'Tools', href: '/tools/' },
	{ label: 'Documentation', href: '/documentation/' },
];

const { pathname } = Astro.url;
const isCurrent = (href: string) =>
	href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<div class="header sl-flex">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>
	<nav class="site-nav sl-flex" aria-label="Site">
		{
			links.map((link) => (
				<a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
					{link.label}
				</a>
			))
		}
	</nav>
	<div class="sl-flex print:hidden search-wrapper">
		<Search />
	</div>
	<div class="sl-hidden md:sl-flex print:hidden right-group">
		<div class="sl-flex social-icons">
			<SocialIcons />
		</div>
	</div>
</div>

<script>
	// Only three or four of the six links fit on a phone, so the nav scrolls.
	// Nothing says so, and it starts at "Home" with the page you are actually on
	// off the end. Start it on the current section and fade the edge while there
	// is more to reach.
	const nav = document.querySelector<HTMLElement>('.site-nav');
	if (nav) {
		const current = nav.querySelector<HTMLAnchorElement>('[aria-current="page"]');
		if (current) {
			const link = current.getBoundingClientRect();
			const box = nav.getBoundingClientRect();
			nav.scrollLeft += link.left - box.left - (box.width - link.width) / 2;
		}
		const sync = () => {
			const end = nav.scrollWidth - nav.clientWidth;
			nav.style.setProperty('--fade-start', nav.scrollLeft > 1 ? '2rem' : '0px');
			nav.style.setProperty('--fade-end', nav.scrollLeft < end - 1 ? '2rem' : '0px');
		};
		nav.addEventListener('scroll', sync, { passive: true });
		window.addEventListener('resize', sync);
		sync();
	}
</script>

<style>
	.header {
		gap: var(--sl-nav-gap);
		justify-content: space-between;
		align-items: center;
		height: 100%;
		/* the bar is full-bleed, but its contents line up with the page frame
		   so the logo sits above the content rather than out at the window edge */
		max-width: var(--au-frame-width);
		margin-inline: auto;
		width: 100%;
	}

	.title-wrapper {
		overflow: clip;
		padding: 0.25rem;
		margin: -0.25rem;
		min-width: 0;
	}

	/* On a phone there is not room for the logo, the site name and the nav, so
	   the name gets clipped mid-word. Drop it to the logo, which is the same
	   link home, and keep the text for screen readers. */
	@media (max-width: 50rem) {
		.title-wrapper :global(.site-title > span) {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
			white-space: nowrap;
		}
	}

	.site-nav {
		gap: 1.25rem;
		align-items: center;
		min-width: 0;
		overflow-x: auto;
		scrollbar-width: none;
		-ms-overflow-style: none;
		/* The script above widens whichever end still has links behind it, so an
		   edge is faded only while there is something past it to scroll to. */
		--fade-start: 0px;
		--fade-end: 0px;
		-webkit-mask-image: linear-gradient(
			to right,
			transparent,
			#000 var(--fade-start),
			#000 calc(100% - var(--fade-end)),
			transparent
		);
		mask-image: linear-gradient(
			to right,
			transparent,
			#000 var(--fade-start),
			#000 calc(100% - var(--fade-end)),
			transparent
		);
	}
	.site-nav::-webkit-scrollbar {
		display: none;
	}
	.site-nav a {
		white-space: nowrap;
	}

	/* below the desktop breakpoint the nav is the only navigation there is,
	   so tighten it rather than hiding it */
	@media (max-width: 72rem) {
		.site-nav {
			gap: 0.85rem;
		}
	}
	.site-nav a {
		color: #fff;
		font-weight: 600;
		font-size: var(--sl-text-sm);
		text-decoration: none;
		padding: 0.25rem 0.15rem;
		border-bottom: 2px solid transparent;
	}
	.site-nav a:hover {
		border-bottom-color: rgba(104, 234, 149, 0.6);
	}
	.site-nav a[aria-current='page'] {
		border-bottom-color: var(--primary-color);
		color: var(--primary-color);
	}

	.search-wrapper {
		flex: 1;
		justify-content: flex-end;
		max-width: 20rem;
		margin-inline-start: auto;
	}

	.right-group,
	.social-icons {
		gap: 1rem;
		align-items: center;
	}
</style>
