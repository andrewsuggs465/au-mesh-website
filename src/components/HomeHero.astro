---
// Homepage hero: club intro + primary calls to action, with a mesh-network
// motif on the right.
---

<section class="home-hero not-content">
	<div class="copy">
		<p class="eyebrow">Auburn University · Electrical &amp; Computer Engineering</p>
		<h1>AU <span class="accent">Mesh</span> Club</h1>
		<p class="tagline">
			A student-led organization focused on embedded systems, wireless and mesh
			networks, and related technologies.
		</p>
		<div class="actions">
			<a class="btn btn-solid" href="https://auburn.campuslabs.com/engage/organization/aumesh">Join the Club</a>
			<a class="btn btn-outline" href="https://discord.gg/PmmSCSw7Dn">Discord</a>
			<a class="btn btn-outline" href="https://www.instagram.com/aumeshclub/">Instagram</a>
			<a class="btn btn-outline" href="mailto:aumeshclub@outlook.com">Contact us</a>
			<a class="btn btn-text" href="/documentation/">Read the docs →</a>
		</div>
	</div>
	<div class="art" aria-hidden="true">
		<svg viewBox="0 0 320 260" xmlns="http://www.w3.org/2000/svg">
			<g stroke="#68ea95" stroke-width="1.25" opacity="0.3">
				<line x1="40" y1="60" x2="120" y2="30" />
				<line x1="120" y1="30" x2="210" y2="50" />
				<line x1="210" y1="50" x2="280" y2="90" />
				<line x1="40" y1="60" x2="70" y2="140" />
				<line x1="120" y1="30" x2="160" y2="120" />
				<line x1="210" y1="50" x2="160" y2="120" />
				<line x1="280" y1="90" x2="250" y2="160" />
				<line x1="70" y1="140" x2="160" y2="120" />
				<line x1="160" y1="120" x2="250" y2="160" />
				<line x1="70" y1="140" x2="110" y2="210" />
				<line x1="160" y1="120" x2="200" y2="230" />
				<line x1="250" y1="160" x2="200" y2="230" />
				<line x1="250" y1="160" x2="290" y2="220" />
				<line x1="110" y1="210" x2="200" y2="230" />
			</g>
			<!-- packets running outward from the hub; drawn hub-first so they
			     travel away from the centre -->
			<g class="packets" stroke="#68ea95" stroke-width="2" stroke-linecap="round">
				<line x1="160" y1="120" x2="120" y2="30" />
				<line x1="160" y1="120" x2="210" y2="50" />
				<line x1="160" y1="120" x2="70" y2="140" />
				<line x1="160" y1="120" x2="250" y2="160" />
				<line x1="160" y1="120" x2="200" y2="230" />
				<line x1="250" y1="160" x2="290" y2="220" />
			</g>
			<g class="nodes" fill="#68ea95">
				<circle cx="40" cy="60" r="4" style="--o: 0.55" />
				<circle cx="120" cy="30" r="5" style="--o: 0.7" />
				<circle cx="210" cy="50" r="4" style="--o: 0.55" />
				<circle cx="280" cy="90" r="4" style="--o: 0.45" />
				<circle cx="70" cy="140" r="5" style="--o: 0.7" />
				<circle class="hub" cx="160" cy="120" r="6" style="--o: 0.8" />
				<circle cx="250" cy="160" r="5" style="--o: 0.7" />
				<circle cx="110" cy="210" r="4" style="--o: 0.5" />
				<circle cx="200" cy="230" r="4" style="--o: 0.55" />
				<circle cx="290" cy="220" r="3" style="--o: 0.4" />
			</g>
			<circle class="ring" cx="160" cy="120" r="12" fill="none" stroke="#68ea95" />
			<circle class="ring ring-2" cx="160" cy="120" r="20" fill="none" stroke="#68ea95" />
		</svg>
	</div>
</section>

<style>
	.home-hero {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
		align-items: center;
		gap: 3rem;
		padding: 3.5rem 0 3rem;
	}

	.eyebrow {
		margin: 0 0 0.75rem;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
	}

	h1 {
		margin: 0;
		font-size: clamp(2.4rem, 5vw, 3.4rem);
		font-weight: 700;
		line-height: 1.1;
		color: #fff;
	}
	h1 .accent {
		color: var(--primary-color);
	}

	.tagline {
		margin: 1.25rem 0 0;
		max-width: 34rem;
		font-size: 1.125rem;
		line-height: 1.6;
		color: var(--fg-color);
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.btn {
		display: inline-block;
		padding: 0.6rem 1.4rem;
		border-radius: 6px;
		font-weight: 600;
		font-size: 0.95rem;
		text-decoration: none;
		transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
	}
	.btn-solid {
		background-color: var(--primary-color);
		color: var(--bg-color);
	}
	.btn-solid:hover {
		background-color: #8ff5b1;
		text-decoration: none;
	}
	.btn-outline {
		border: 1px solid var(--primary-color);
		color: var(--primary-color);
	}
	.btn-outline:hover {
		background-color: var(--hover-bg);
		text-decoration: none;
	}
	.btn-text {
		padding-inline: 0.5rem;
		color: var(--primary-color);
	}

	.art svg {
		width: 100%;
		height: auto;
	}

	/* ── mesh animation ──
	   Packets run outward along the links, the hub broadcasts rings, and the
	   nodes breathe. The graphic is decorative (aria-hidden), so all of it
	   stops for anyone who asks for reduced motion. */
	.nodes circle {
		opacity: var(--o);
		animation: node-breathe 4.5s ease-in-out infinite;
	}
	.nodes circle:nth-child(3n) {
		animation-delay: -0.9s;
	}
	.nodes circle:nth-child(3n + 1) {
		animation-delay: -2.4s;
	}
	.nodes circle:nth-child(3n + 2) {
		animation-delay: -3.6s;
	}
	.nodes .hub {
		animation-duration: 3s;
	}

	@keyframes node-breathe {
		0%,
		100% {
			opacity: var(--o);
		}
		50% {
			opacity: 1;
		}
	}

	/* a 6-unit dash with a long gap: it crosses the link, then the link sits
	   empty for the rest of the cycle */
	.packets line {
		stroke-dasharray: 6 200;
		stroke-dashoffset: 206;
		opacity: 0.9;
		animation: packet 3.4s linear infinite;
	}
	.packets line:nth-child(2) {
		animation-delay: 1.1s;
	}
	.packets line:nth-child(3) {
		animation-delay: 2.2s;
	}
	.packets line:nth-child(4) {
		animation-delay: 0.6s;
	}
	.packets line:nth-child(5) {
		animation-delay: 1.7s;
	}
	.packets line:nth-child(6) {
		animation-delay: 2.8s;
	}

	@keyframes packet {
		to {
			stroke-dashoffset: 0;
		}
	}

	.ring {
		transform-box: fill-box;
		transform-origin: center;
		animation: ring-out 3.6s ease-out infinite;
	}
	.ring-2 {
		animation-delay: 1.8s;
	}

	@keyframes ring-out {
		0% {
			transform: scale(0.35);
			opacity: 0.5;
		}
		70% {
			opacity: 0.12;
		}
		100% {
			transform: scale(2.6);
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.nodes circle,
		.ring {
			animation: none;
		}
		.packets line {
			animation: none;
			opacity: 0;
		}
		.ring {
			opacity: 0.4;
		}
		.ring-2 {
			opacity: 0.15;
		}
	}

	@media (max-width: 50rem) {
		.home-hero {
			grid-template-columns: 1fr;
			gap: 1.5rem;
			padding-top: 2rem;
		}
		.art {
			max-width: 18rem;
			margin: 0 auto;
			opacity: 0.8;
		}
	}
</style>
