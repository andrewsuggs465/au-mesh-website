---
// Sponsorship matrix for Hack the Plains, transcribed from the 2027
// sponsorship one-pager. Tiers are cumulative, so each benefit stores the
// lowest tier that includes it and the row fills from there rightward.
// Sponsorship status. Flip OPEN to true when applications go out; the status
// line below is the only thing that reads these two.
const OPEN = false;
const APPLICATIONS = { iso: '2026-10-01', label: 'October 1, 2026' };

const tiers = [
	{ name: 'Bronze', price: '$250' },
	{ name: 'Silver', price: '$750' },
	{ name: 'Gold', price: '$2,000' },
	{ name: 'Title', price: '$4,000' },
];

const benefits: [string, number][] = [
	['Logo on the event website and venue signage', 0],
	['Named in the opening and closing ceremonies', 0],
	['Logo on the event t-shirt', 1],
	['Recruiting table on site all day Sunday', 1],
	['Resume book from participating students', 1],
	['Swag or literature in every hacker bag', 1],
	['Named award for a technical goal you set', 2],
	['30-minute workshop or technical talk', 2],
	['Seat on the judging panel', 2],
	['Named in the event title and all press', 3],
	['Opening keynote slot', 3],
	['Top billing on every surface, one sponsor only', 3],
];
---

<div class="sponsor-tiers not-content">
	<p class="status" data-open={OPEN}>
		<span class="state">{OPEN ? 'Sponsorship open' : 'Sponsorship closed'}</span>
		{
			!OPEN && (
				<span class="when">
					Applications go out from <time datetime={APPLICATIONS.iso}>{APPLICATIONS.label}</time>
				</span>
			)
		}
	</p>

	<div class="scroller" tabindex="0" role="region" aria-label="Sponsorship tiers">
		<table>
			<thead>
				<tr>
					<th scope="col" class="benefit">Benefit</th>
					{
						tiers.map((tier) => (
							<th scope="col">
								<span class="tier">{tier.name}</span>
								<span class="price">{tier.price}</span>
							</th>
						))
					}
				</tr>
			</thead>
			<tbody>
				{
					benefits.map(([label, from]) => (
						<tr>
							<th scope="row" class="benefit">
								{label}
							</th>
							{tiers.map((tier, i) =>
								i >= from ? (
									<td class="yes">
										<span aria-hidden="true">✓</span>
										<span class="sr-only">Included in {tier.name}</span>
									</td>
								) : (
									<td />
								)
							)}
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
</div>

<style>
	.sponsor-tiers {
		margin-top: 1.5rem;
	}

	/* Status carries the state, so the left rule carries the colour: mint while
	   sponsorship is live, grey while it is not. Same 3px rule as the section
	   headings, so it reads as part of the same system. */
	.status {
		margin: 0 0 1.25rem;
		padding-left: 0.75rem;
		border-left: 3px solid var(--sl-color-gray-4);
		font-size: 0.95rem;
		line-height: 1.5;
	}
	.status[data-open='true'] {
		border-left-color: var(--primary-color);
	}
	.state {
		display: block;
		color: var(--fg-color);
		font-weight: 600;
	}
	.when {
		display: block;
		color: var(--sl-color-gray-3);
	}
	.when time {
		font-family: var(--sl-font-mono), monospace;
		font-size: 0.875rem;
	}

	/* Four tier columns plus the benefit text need about 40rem. Below that the
	   table scrolls sideways instead of wrapping every benefit to four lines. */
	.scroller {
		overflow-x: auto;
	}
	.scroller:focus-visible {
		outline: 2px solid var(--primary-color);
		outline-offset: 2px;
	}

	table {
		width: 100%;
		min-width: 40rem;
		border-collapse: collapse;
	}

	th,
	td {
		padding: 0.6rem 0.75rem;
		text-align: center;
		border-bottom: 1px solid var(--border-color);
		font-weight: 400;
	}

	/* The benefit column is the reading column, so it stays left-aligned and
	   pinned while the tiers scroll past it. */
	.benefit {
		position: sticky;
		left: 0;
		text-align: left;
		background-color: var(--bg-color);
		width: 60%;
		color: var(--fg-color);
		font-size: 0.95rem;
		line-height: 1.4;
	}

	thead th {
		border-bottom: 1px solid var(--primary-color);
		vertical-align: bottom;
	}
	thead .benefit {
		color: var(--sl-color-gray-3);
		font-size: 0.85rem;
	}

	.tier {
		display: block;
		color: #fff;
		font-weight: 650;
		font-size: 1rem;
	}
	/* money is machine data, like every other figure on the site */
	.price {
		display: block;
		margin-top: 0.15rem;
		font-family: var(--sl-font-mono), monospace;
		font-size: 0.8rem;
		color: var(--sl-color-gray-3);
	}

	/* Mint is the whole table: a check means the tier includes the row, an
	   empty cell means it does not. No other colour appears here. */
	.yes {
		color: var(--primary-color);
		font-size: 1rem;
		line-height: 1;
	}

	/* At 343px of content the 60% benefit column is 359px wide, so the sticky
	   label covers every tier and nothing scrolls into view beside it. Narrow
	   the label to 14rem and the table to 32rem, which leaves about 100px of
	   tier columns visible next to it. */
	@media (max-width: 40rem) {
		table {
			min-width: 32rem;
		}
		.benefit {
			width: 14rem;
		}
		th,
		td {
			padding: 0.6rem 0.5rem;
		}
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

</style>
