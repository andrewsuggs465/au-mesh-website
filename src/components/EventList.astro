---
import EventCard from './EventCard.astro';
import { upcomingEvents, pastEvents } from '../lib/events';

const upcoming = upcomingEvents();
const past = pastEvents();
---

{
	upcoming.length > 0 ? (
		upcoming.map((event) => <EventCard event={event} />)
	) : (
		<p>No events on the calendar right now — check back soon or ask in Discord.</p>
	)
}

{
	past.length > 0 && (
		<>
			<h2>Past events</h2>
			{past.map((event) => (
				<EventCard event={event} past />
			))}
		</>
	)
}
