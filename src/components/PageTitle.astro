---
/**
 * Starlight's page title, rendered over the cover image when a page has one.
 *
 * Only news posts set `cover:`, so every other page falls through to the plain
 * heading Starlight would have rendered, underline and all.
 */
import { Image } from 'astro:assets';

// Starlight's own PAGE_TITLE_ID. It is not exported from a public entry point,
// and `src/styles/custom.css` already depends on the value, so it is spelled
// out here too.
const PAGE_TITLE_ID = '_top';

const { entry } = Astro.locals.starlightRoute;
const { title, cover, coverAlt, date, author } = entry.data as typeof entry.data & {
	cover?: ImageMetadata;
	coverAlt?: string;
	date?: Date;
	author?: string;
};

const byline = [
	date?.toLocaleDateString('en-US', {
		month: 'long',
		day: 'numeric',
		year: 'numeric',
		timeZone: 'UTC',
	}),
	author,
]
	.filter(Boolean)
	.join(' · ');
---

{
	cover ? (
		<div class="page-hero">
			<Image
				class="hero-img"
				src={cover}
				alt={coverAlt ?? ''}
				width={1400}
				widths={[640, 960, 1400]}
				sizes="(min-width: 60rem) 60rem, 100vw"
				loading="eager"
			/>
			<div class="hero-text">
				<h1 id={PAGE_TITLE_ID}>{title}</h1>
				{byline && (
					<p class="hero-meta">
						{date && <time datetime={date.toISOString()}>{byline}</time>}
					</p>
				)}
			</div>
		</div>
	) : (
		<h1 id={PAGE_TITLE_ID}>{title}</h1>
	)
}

<style>
	@layer starlight.core {
		h1 {
			margin-top: 1rem;
			font-size: var(--sl-text-h1);
			line-height: var(--sl-line-height-headings);
			font-weight: 600;
			color: var(--sl-color-white);
		}
	}

	.page-hero {
		position: relative;
		margin-top: 1rem;
		aspect-ratio: 3 / 1;
		border-radius: 10px;
		overflow: hidden;
		isolation: isolate;
	}

	.page-hero .hero-img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		/* The group sits high in a portrait frame. Centring the crop on the
		   faces keeps everyone's head in the band. */
		object-position: center 42%;
	}

	/* Dark at the bottom so the title stays readable, and finishing on the page
	   background so the photo dissolves into the article rather than ending on a
	   hard edge. */
	.page-hero::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(
			to top,
			var(--bg-color) 0%,
			color-mix(in srgb, var(--bg-color) 90%, transparent) 20%,
			color-mix(in srgb, var(--bg-color) 50%, transparent) 42%,
			color-mix(in srgb, var(--bg-color) 14%, transparent) 68%,
			transparent 88%
		);
	}

	.hero-text {
		position: absolute;
		inset-inline: 0;
		bottom: 0;
		z-index: 1;
		padding: 1.5rem 1.6rem 1.25rem;
	}

	.page-hero h1 {
		margin: 0;
		color: #fff;
		text-wrap: balance;
		text-shadow: 0 2px 12px rgba(0, 0, 0, 0.55);
	}

	.hero-meta {
		margin: 0.4rem 0 0;
		font-size: 0.85rem;
		color: var(--sl-color-gray-2);
		text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
	}

	/* The 3:1 band gets too short to read faces in once the column narrows, so
	   the crop opens back up in steps. It has to be done with the ratio rather
	   than a min-height: a min-height on an `aspect-ratio` box is transferred
	   back into the width, which blows the hero out past the viewport and makes
	   the phone zoom the whole page out to fit. */
	@media (max-width: 45rem) {
		.page-hero {
			aspect-ratio: 2 / 1;
		}
		.hero-text {
			padding: 1.1rem 1.1rem 1rem;
		}
	}

	@media (max-width: 30rem) {
		.page-hero {
			aspect-ratio: 3 / 2;
		}
	}
</style>
